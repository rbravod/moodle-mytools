#!/usr/bin/env bash
set -e

ENV_NAME="$1"
shift

# Base paths.
BASE_DIR="/home/roberto/workspace"
DB_BASE_DIR="$BASE_DIR/db-data"
DOCKER_DIR="$BASE_DIR/moodle-docker"

# Default values.
PERSISTENT_DB=0
DB_DATA_DIR=""
COMPOSE_PROJECT_NAME=""
MOODLE_DOCKER_WWWROOT=""
MOODLE_DOCKER_WEB_PORT=""
MOODLE_DOCKER_DB="pgsql"
MOODLE_DOCKER_WEB_HOST=""
MOODLE_DOCKER_EXTRA_COMPOSE_FILE=""
MOODLE_DOCKER_PHP_VERSION="8.3"
MOODLE_DOCKER_BROWSER="firefox"
MOODLE_DOCKER_SELENIUM_VNC_PORT="5900"

# Environment switch.
case "$ENV_NAME" in
  stable)
    COMPOSE_PROJECT_NAME="stable"
    MOODLE_DOCKER_WWWROOT="$BASE_DIR/stable"
    MOODLE_DOCKER_WEB_PORT="8081"
    MOODLE_DOCKER_DB=pgsql
    MOODLE_DOCKER_DB_PORT=5432
    MOODLE_DOCKER_WEB_HOST="localhost"
    ;;

  dev)
    COMPOSE_PROJECT_NAME="dev"
    MOODLE_DOCKER_WWWROOT="$BASE_DIR/dev"
    MOODLE_DOCKER_WEB_PORT="8082"
    MOODLE_DOCKER_DB=pgsql
    MOODLE_DOCKER_DB_PORT=5433
    MOODLE_DOCKER_WEB_HOST="localhost"
    ;;

  lts)
    COMPOSE_PROJECT_NAME="lts"
    MOODLE_DOCKER_WWWROOT="$BASE_DIR/lts"
    MOODLE_DOCKER_WEB_PORT="8083"
    MOODLE_DOCKER_DB=pgsql
    MOODLE_DOCKER_DB_PORT=5434
    MOODLE_DOCKER_WEB_HOST="localhost"
    #MOODLE_DOCKER_BROWSER="chrome"
    #MOODLE_DOCKER_SELENIUM_VNC_PORT="5901"
    ;;

  vuela)
    COMPOSE_PROJECT_NAME="vuela"
    MOODLE_DOCKER_WWWROOT="$BASE_DIR/vuela/src"
    MOODLE_DOCKER_WEB_PORT="0.0.0.0:8080"
    MOODLE_DOCKER_DB=mariadb
    MOODLE_DOCKER_DB_PORT=3307
    MOODLE_DOCKER_WEB_HOST="moodle-dev.local"
    PERSISTENT_DB=1
    DB_DATA_DIR="$DB_BASE_DIR/vuela"
    # MOODLE_DOCKER_PHP_VERSION="8.1"
    ;;

  *)
    echo "Usage: $0 {stable|dev|lts|vuela} <docker-compose args>"
    exit 1
    ;;
esac

if [ "$PERSISTENT_DB" = "1" ]; then
    MOODLE_DOCKER_EXTRA_COMPOSE_FILE="$DOCKER_DIR/db.mariadb.persistent.yml"
fi

# Execute moodle-docker-compose with env.
COMPOSE_PROJECT_NAME="$COMPOSE_PROJECT_NAME" \
MOODLE_DOCKER_WWWROOT="$MOODLE_DOCKER_WWWROOT" \
MOODLE_DOCKER_WEB_PORT="$MOODLE_DOCKER_WEB_PORT" \
MOODLE_DOCKER_DB="$MOODLE_DOCKER_DB" \
MOODLE_DOCKER_DB_PORT="$MOODLE_DOCKER_DB_PORT" \
MOODLE_DOCKER_WEB_HOST="$MOODLE_DOCKER_WEB_HOST" \
DB_DATA_DIR="$DB_DATA_DIR" \
MOODLE_DOCKER_EXTRA_COMPOSE_FILE="$MOODLE_DOCKER_EXTRA_COMPOSE_FILE" \
MOODLE_DOCKER_PHP_VERSION="$MOODLE_DOCKER_PHP_VERSION" \
MOODLE_DOCKER_BROWSER="$MOODLE_DOCKER_BROWSER" \
MOODLE_DOCKER_SELENIUM_VNC_PORT="$MOODLE_DOCKER_SELENIUM_VNC_PORT" \
"$DOCKER_DIR/bin/moodle-docker-compose" "$@"
